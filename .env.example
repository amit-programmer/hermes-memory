# ==========================================
# HERMES CO-FOUNDER AGENT - ENVIRONMENT CONFIG
# Copy this file to .env and fill in your keys:
# cp .env.example .env
# ==========================================

# 1. Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram Chat ID (from @userinfobot)
TELEGRAM_OWNER_ID=

# 2. Tier 1: Upstash Redis (REST API)
# Get from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 3. Tier 2: Turso libSQL Database
# Get from https://turso.tech/
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 4. Tier 3: Supabase (Permanent Brain & pgvector)
# Get from https://supabase.com/dashboard/project/<ref>/settings/api
SUPABASE_URL=
SUPABASE_KEY=

# 5. Embeddings: Hugging Face (BAAI/bge-small-en-v1.5)
# Get free token from https://huggingface.co/settings/tokens
HF_TOKEN=
# HF_EMBED_URL=  # Optional: defaults to public Hugging Face router pipeline

# 6. LLM Reasoning Engine (Choose one or more)
# Groq API (Fast inference) from https://console.groq.com/
GROQ_API_KEY=
# Or OpenAI API from https://platform.openai.com/
OPENAI_API_KEY=
# Or Self-Hosted / Remote Hermes OpenAI-compatible endpoint:
HERMES_URL=
HERMES_MODEL=hermes

# 7. Optional Tool Integrations
GITHUB_TOKEN=

# 8. Server Configuration (Port 7860 is default for Hugging Face Spaces)
PORT=7860
HOST=0.0.0.0
